# 凭据 —— 绝不入库
.env

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.coverage
htmlcov/
.ruff_cache/

# 数据与产物（体积大 / 含截图，不入库）
# 注意：`data/` 本身是代码模块（M2 交付物 1），不能整目录忽略，
# 只忽略它下面存放原始数据与中间产物的子目录。
data/raw/
data/processed/
data/cache/
# OCR 对照实验的两组测试图：合成集由 make_ocr_testset.py 按固定种子
# 复现，真实集是从 ScreenSpot-v2 复制的第三方数据，都不随本仓库分发
data/ocr-testset/
data/ocr-realset/
logs/
outputs/
*.pth
*.safetensors
*.bin

# 第三方材料，不随本仓库分发
# - 实习方的项目大纲：对方的材料，不是本项目的产出
# - arXiv 论文：受版权保护，且共 18MB。引用写链接即可
*.pdf
milestone/大模型_AI_Agent_项目大纲*.md
milestone/revision-brief.html

# 个人交付草稿（Word），不进公开仓库
*.docx
*.doc

# 环境
.venv/
venv/

# 编辑器
.vscode/
.idea/
*.swp

# 系统
Thumbs.db
desktop.ini
.DS_Store

# 微调数据是生成物：`python -m finetune.dataset` 一条命令重建，
# 且内容依赖 data/raw 里的原始数据集与截图路径。meta.json 例外——
# 它记着划分指纹与动作分布，是报告要引的证据。
finetune/data/*.jsonl
finetune/outputs/

# 交付用的压缩包是打包产物：目录本身入库，zip 由 Compress-Archive 现做。
# **130 MB 的训练上传包尤其不能进** —— git 会永久保留每个 blob，
# 提交一次仓库就再也瘦不回来了。
delivery/*.zip
gui-agent-train.zip

# letterbox 实验的中间图片：254MB，由 scripts/make_letterbox_val.py 可重建
data/letterbox-16x9/
finetune/data/val-16x9*.jsonl
finetune/data/val-4x3-coords.jsonl

# upscale 实验的中间图片：由 scripts/make_upscaled_val.py 可重建
data/upscaled-0622/
finetune/data/val-upscaled-coords.jsonl

# 个人求职准备材料，与项目交付无关，只留本地
GUI_Agent_大厂面试深挖指南_复核完善版.md
必备知识手册.md
面试答案.md
