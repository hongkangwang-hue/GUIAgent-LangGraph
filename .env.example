# 复制到用户目录 ~/.gui-agent/.env 并填入真实值；不要把密钥放进仓库。
#
# 三家平台都走 OpenAI 兼容端点，因此共用同一个后端实现
# （llm/openai_compat.py）。切换平台只改 LLM_PROVIDER，不动代码。

# 默认使用哪个平台：dashscope / zhipu / nvidia / selfhost
#
# 在线版用 dashscope；离线版用 selfhost（见文件末尾），
# 两者的差别只有这一行，Agent 代码一行不改。
LLM_PROVIDER=dashscope

# --- 阿里云百炼（视觉模型）---
# 默认使用已完成基础任务 5×5 实测的 qwen3-vl-8b-instruct。
# qwen3.7-plus 可通过 --model 单独试验；其 GUI 坐标表现尚未校准。
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
PLANNER_MODEL=qwen3-vl-8b-instruct

# --- 智谱开放平台（GLM-4V）---
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_MODEL=glm-4.6v-flash

# --- NVIDIA NIM（Llama 3.2 Vision）---
# 注意：该平台对内联 base64 图片有硬上限，超过要改走 NVCF 资产上传接口。
# 后端会自动把截图压到限制内，压不下去时会告警。
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.2-11b-vision-instruct

# --- 计费单价（元 / 千 token）---
#
# 不填也能跑，但**成本熔断会失效**，且轨迹里的 cost_cny 会标成不可信
# （CostInfo.priced=False）。项目规矩是不猜单价：假成本比"未知"更有害，
# M0 的成本估算要靠 M2 的实测数据校准，掺了猜测就白测了。
#
# 要启用熔断，去平台的计费页面抄真实单价填在这里。
DASHSCOPE_PRICE_IN_PER_1K=
DASHSCOPE_PRICE_OUT_PER_1K=
ZHIPU_PRICE_IN_PER_1K=
ZHIPU_PRICE_OUT_PER_1K=
NVIDIA_PRICE_IN_PER_1K=
NVIDIA_PRICE_OUT_PER_1K=

# --- 本地 grounding 模型（M3）---
LOCAL_GROUNDING_MODEL_PATH=

# --- 自建本地服务（离线版，M3）---
#
# 这是**客机**的配置。宿主机上先起服务：
#
#     python scripts/serve_local_model.py --host 0.0.0.0 --preload --adapter finetune/outputs/<run>/adapter
#
# 然后把下面的 IP 换成宿主机在 VMware NAT 网段（VMnet8）上的地址，并把最上面的
# LLM_PROVIDER 改成 selfhost。
#
# **权重跑在宿主机 GPU 上，截图不出本机**——宿主机与客机是同一台物理机，
# 走 VMware 的虚拟网卡（本项目用 NAT / VMnet8）。这满足大纲 W3 的「本地部署」，见
# milestone/milestone-0-overview.md《硬件与部署环境》。
#
# 与短租远程服务器要分开：那种情况权重在别人机器上，只算 API 调用。
SELFHOST_API_KEY=local
SELFHOST_BASE_URL=http://127.0.0.1:8000/v1
SELFHOST_MODEL=Qwen/Qwen2.5-VL-3B-Instruct

# 自建服务的 API 费用是**确认的 0**，不是「未知」——不需要填单价，
# 代码里已按 0 处理且 priced=True。真要把电费折算进去时才填这两项。
# SELFHOST_PRICE_IN_PER_1K=
# SELFHOST_PRICE_OUT_PER_1K=

# --- 运行时 ---
# 全局急停热键
EMERGENCY_STOP_HOTKEY=<ctrl>+<alt>+q

# PaddleOCR 需要关掉 oneDNN（paddlepaddle 3.3.1 的 PIR 执行器在该路径上
# 有 bug）。代码里已经 setdefault 了这一项，这里留着是为了能显式开回去
# 排查问题。
# PADDLE_PDX_ENABLE_MKLDNN_BYDEFAULT=False
